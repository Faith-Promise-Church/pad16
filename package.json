{
  "name": "pad16",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "kits": "node scripts/build-kits.mjs",
    "build": "node scripts/build-kits.mjs && vite build",
    "build:ios": "node scripts/build-kits.mjs && PAD16_TARGET=ios vite build && cap sync ios",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:all": "npm run typecheck && vitest run && playwright test",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "fake-indexeddb": "^6.2.8",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@capacitor/core": "^8.6.2",
    "@capacitor/ios": "^8.6.2",
    "@fontsource/barlow": "^5.3.0",
    "fflate": "^0.8.3",
    "signalsmith-stretch": "^1.3.2",
    "pad16-native": "file:plugins/pad16-native"
  }
}
